<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vallegrande.edu.pe.preguntaspreguntonas.controller.QuizController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Indicador de tiempo -->
    <Label fx:id="lblTimer" styleClass="score-label" text="Tiempo: 50s" />
    <Label fx:id="lblScore" styleClass="score-label" text="Puntaje: 0 / 10" />
    <Label fx:id="lblQuestion" styleClass="question-label" text="Pregunta aquí" wrapText="true" />

    <VBox alignment="CENTER" spacing="10.0">
        <Button fx:id="btnOpt0" maxWidth="Infinity" onAction="#handleOptionAction" styleClass="option-btn" text="Opción 1" />
        <Button fx:id="btnOpt1" maxWidth="Infinity" onAction="#handleOptionAction" styleClass="option-btn" text="Opción 2" />
        <Button fx:id="btnOpt2" maxWidth="Infinity" onAction="#handleOptionAction" styleClass="option-btn" text="Opción 3" />
        <Button fx:id="btnOpt3" maxWidth="Infinity" onAction="#handleOptionAction" styleClass="option-btn" text="Opción 4" />
    </VBox>
</VBox>