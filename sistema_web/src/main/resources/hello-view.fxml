<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vallegrande.edu.pe.sistema_web.Controller.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Lista de Registros">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre / Empresa" />
            <TableColumn fx:id="colEmail" prefWidth="150.0" text="Correo Electrónico" />
            <TableColumn fx:id="colTelefono" prefWidth="100.0" text="Teléfono" />
            <TableColumn fx:id="colProducto" prefWidth="120.0" text="Producto" />
            <TableColumn fx:id="colTipoComprador" prefWidth="130.0" text="Tipo Comprador" />
            <TableColumn fx:id="colMensaje" prefWidth="200.0" text="Mensaje" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>